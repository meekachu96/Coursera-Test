  width: 60%;
  min-width: 300px;
  margin-top: 1em;
  margin-bottom: 1em;
  margin-left: auto;
  margin-right: auto;
  height: 2em;
  font-size: 1.1rem;
  background-color: grey;
  border-color: purple;
  color: purple;
  font-style: bold;
}
